# One container for Render: builds the dashboard, then serves it with the API (backend/render_app.py).
FROM node:22-alpine AS dashboard
WORKDIR /dashboard
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./
COPY --from=dashboard /dashboard/dist ./static
RUN useradd --create-home appuser
USER appuser
EXPOSE 10000
# One worker: MOCK_DATA keeps its demo database in this process's temp dir.
CMD ["sh", "-c", "exec uvicorn render_app:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*' --no-access-log"]
