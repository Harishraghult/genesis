# TEST-ONLY Vercel demo. Not for real student data. Set these in Vercel (Project > Settings > Environment Variables).
# Demo mode enables the seeded demo accounts on a public URL, so use a strong DEV_PASSWORD and never real data.
APP_ENV=development
ENABLE_DEV_AUTH=true
DEV_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# From your managed Postgres provider, in postgresql+psycopg:// form with ?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Three different random strings, 32+ characters each (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
QR_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
POLICY_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
BLE_TOKEN_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_16_BYTES
FACE_CHECK_MODE=enrolled
FACE_TEMPLATE_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES
RESOURCE_ALLOWED_HOSTS=college.example.edu
PLAY_INTEGRITY_MODE=off
CORS_ORIGINS=https://YOUR_VERCEL_DOMAIN
# One-time database setup from your own PC (PowerShell), with the same values exported first:
#   cd backend
#   pip install -r requirements.txt
#   $env:DATABASE_URL="..."; $env:APP_ENV="development"; $env:ENABLE_DEV_AUTH="true"; $env:DEV_PASSWORD="..."
#   alembic upgrade head
#   python -m app.seed
# Phone build (debug) pointing at the deployment:
#   cd android; .\gradlew.bat :app:installDebug -PAPI_BASE_URL=https://YOUR_VERCEL_DOMAIN/api
