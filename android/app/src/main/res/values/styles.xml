<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FlInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="FlButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="FlButton.Secondary">
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="FlSmallButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
